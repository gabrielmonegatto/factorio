{
  // purchase-check: o elo que fecha o ciclo de atribuição.
  // Cron 5min: vendas PAGAS no gateway -> dedup (purchases_sent) -> casamento
  // pelo sck (= session_id) -> Purchase no CAPI -> livro-caixa.
  //
  // ⚠️ A ÚNICA parte acoplada ao gateway é `fetchPaidSales()` no src/index.js
  // (adapter B4You/Flow pronto). Plataforma nova = reescrever só essa função,
  // mantendo o contrato: {sale_id, status:'paid', offer_price, sck, customer_*,
  // zipcode/city/state, date_update}.
  //
  // ⚠️ FUSO: antes de confiar em janelas de busca, compare o NOW() do banco do
  // gateway com o date_update de uma venda recém-paga. A B4You grava hora LOCAL
  // sem fuso; janelas curtas contra NOW() UTC voltam vazias (3h de defasagem).
  "name": "{{PROJECT}}-purchase-check",
  "account_id": "{{CF_ACCOUNT_ID}}",
  "main": "src/index.js",
  "compatibility_date": "2025-06-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    { "binding": "CRO_DB", "database_name": "{{D1_NAME}}", "database_id": "{{D1_ID}}" }
  ],
  "vars": {
    "FLOW_API_URL": "{{URL_DA_API_DE_VENDAS}}",
    "DEFAULT_COUNTRY_CODE": "55",
    "LOOKBACK_HOURS": "24",
    "MAX_SENDS_PER_RUN": "50",
    "MAX_PROCESS_PER_RUN": "15"
  }
  // Secrets (wrangler secret put): FLOW_API_TOKEN, META_TOKEN_<MARCA>, CRON_SECRET
  // Ensaio seco sem sujar o pixel: secret META_TEST_EVENT_CODE (aba "Testar
  // eventos" do pixel). NUNCA deixar setado em produção: TODA venda viraria teste.
}
