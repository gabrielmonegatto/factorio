# OmniVoice (k2-fsa) — arma do arsenal: TTS multilíngue 0.6B + voice cloning/design.
# Spike CPU: mede se roda viável na VPS (senão vira arma de surto-GPU no RunPod).
FROM python:3.11-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    git ffmpeg libsndfile1 build-essential curl && rm -rf /var/lib/apt/lists/*

# torch CPU-only (sem CUDA, imagem menor)
RUN pip install --no-cache-dir torch==2.8.0 torchaudio==2.8.0 --extra-index-url https://download.pytorch.org/whl/cpu
RUN pip install --no-cache-dir omnivoice soundfile

# cache do HF fora da imagem (modelo 0.6B baixa 1x pro volume)
ENV HF_HOME=/cache
WORKDIR /app
COPY omni_infer.py /app/omni_infer.py
ENTRYPOINT ["python3", "-u", "omni_infer.py"]
